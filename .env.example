# ---------------------------------------------------------------------------
# Secrets. Never commit a filled-in copy, never expose any of these to a browser
# or embed them in generated creative.
# ---------------------------------------------------------------------------

# Runtime mode: "mock" runs the whole loop with simulated Meta + voice providers
# (no spend, no calls). Switch to "live" only after both human gates pass.
FL_MODE=mock

# --- Meta Marketing API (official API only; no scraping, no UI automation) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_000000000000
META_PAGE_ID=
META_API_VERSION=v21.0
# Shared secret used to verify inbound leadgen webhooks (X-Hub-Signature-256)
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# --- OmniDimension voice agent ---
OMNI_API_KEY=
OMNI_AGENT_ID=
OMNI_BASE_URL=https://api.omnidim.io/api/v1
# Shared secret used to verify inbound post-call webhooks
OMNI_WEBHOOK_SECRET=

# --- AI orchestrator (optional; falls back to a deterministic brief writer) ---
# Also honoured: ANTHROPIC_AUTH_TOKEN, or an `ant auth login` profile on disk.
ANTHROPIC_API_KEY=
# Model used to draft the brief. Defaults to claude-sonnet-5.
FL_BRIEF_MODEL=

# --- Local server ---
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787

# Shared token for the local admin routes (POST /leads, POST /revenue).
# Unset means those routes are closed.
FL_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Secrets. Never commit a filled-in copy, never expose any of these to a browser
# or embed them in generated creative.
# ---------------------------------------------------------------------------

# Runtime mode: "mock" runs the whole loop with simulated Meta + voice providers
# (no spend, no calls). Switch to "live" only after both human gates pass.
FL_MODE=mock

# --- Meta Marketing API (official API only; no scraping, no UI automation) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_000000000000
META_PAGE_ID=
META_API_VERSION=v21.0
# Shared secret used to verify inbound leadgen webhooks (X-Hub-Signature-256)
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# --- OmniDimension voice agent ---
OMNI_API_KEY=
OMNI_AGENT_ID=
OMNI_BASE_URL=https://api.omnidim.io/api/v1
# Preferred: shared secret for an HMAC over the raw body of post-call webhooks.
OMNI_WEBHOOK_SECRET=
# Fallback for providers that can only attach a static header. Weaker - it is
# replayable and proves nothing about the body - but better than an open
# endpoint that records revenue. Sent as `Authorization: Bearer <token>` or
# `X-Webhook-Token`. Set one of these two or the endpoint rejects everything.
OMNI_WEBHOOK_TOKEN=

# --- AI orchestrator (optional; falls back to a deterministic brief writer) ---
# Also honoured: ANTHROPIC_AUTH_TOKEN, or an `ant auth login` profile on disk.
ANTHROPIC_API_KEY=
# Model used to draft the brief. Defaults to claude-sonnet-5.
FL_BRIEF_MODEL=

# --- Local server ---
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787

# --- Deployment (docker compose only) ---
# The hostname you registered, e.g. yourname.dpdns.org. Compose reads this file
# for interpolation as well as passing it to the app, so this one line both
# tells Caddy which certificate to request and sets PUBLIC_BASE_URL to
# https://<DOMAIN>, which is what Meta and OmniDimension will call back on.
# Leave blank for local work; docker compose refuses to start without it.
DOMAIN=

# Tokens for the HTTP routes. Two roles: admin can write (POST /leads,
# POST /revenue, approvals) and read; viewer can only read (GET /runs,
# GET /runs/:id). An unset token authenticates nobody, so leaving both blank
# closes every route except the webhooks and /health.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
FL_ADMIN_TOKEN=
FL_VIEWER_TOKEN=

# --- Logging ---
# Structured logs go to stderr, separately from command output on stdout.
# FL_LOG_FORMAT=json for a log pipeline; anything else prints for a person.
# FL_LOG_LEVEL is debug | info | warn | error and defaults to info.
# Field names that look like secrets are dropped and phone numbers are masked
# on the way out, so neither can be logged by accident.
FL_LOG_FORMAT=
FL_LOG_LEVEL=

# Only for the tunnel route (docker-compose.tunnel.yml), when you have no VPS.
# From Cloudflare Zero Trust -> Networks -> Tunnels. This is a credential:
# it identifies the tunnel and lets anything holding it serve your hostname.
CLOUDFLARE_TUNNEL_TOKEN=

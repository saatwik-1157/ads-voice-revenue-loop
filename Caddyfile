# Caddy obtains and renews a Let's Encrypt certificate for {$DOMAIN}
# automatically. Nothing here needs a key or a cron job.

{$DOMAIN} {
	encode gzip

	# Everything goes to the app, including /health, /health/live and
	# /health/ready - all three are open by design so an uptime check or a load
	# balancer can poll them without a token. The app decides what each says.
	#
	# Nothing here rewrites the request body, which matters: the webhook HMAC is
	# computed over the raw bytes, and a directive that touched the body would
	# break verification for every delivery.
	#
	# X-Forwarded-For is set so the app can rate-limit anonymous callers by their
	# own address rather than by this proxy's. The app only trusts it when
	# FL_TRUST_PROXY=true, which the compose file sets, because a header any
	# client can write is not an identity on its own.
	reverse_proxy app:8787 {
		header_up X-Forwarded-For {remote_host}
	}

	# The app already logs every request as JSON on stderr with a request id.
	# This is the edge view: what arrived before anything was rejected.
	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}
